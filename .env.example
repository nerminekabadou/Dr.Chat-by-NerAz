# PostgreSQL database of the hospital platform (use a read-only user)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=readonly_user
DATABASE_PASSWORD=change-me
DATABASE_SCHEMA=hospital

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-3.8-flash   # optional; newest available Flash model is used if unset or retired

# Optional local Llama model for POST /ask
LLAMA_MODEL_PATH=models/llama-model.gguf

# Backend endpoint used by the Streamlit app
CHAT_API_URL=http://localhost:8000/ask_gemini
